# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL lokal via docker compose) ----
DATABASE_URL=postgres://wcc:wcc@localhost:5432/wcc

# ---- Keamanan ----
# GANTI nilai ini dengan string acak panjang sebelum dipakai di produksi!
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang-minimal-32-karakter
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- CORS / cookie ----
CORS_ORIGIN=http://localhost:5173
# Set true bila sudah memakai HTTPS di produksi.
COOKIE_SECURE=false

# ---- Pembatasan laju permintaan (rate limit) ----
# 0 = NONAKTIF (default): tidak ada blokir sementara / pesan "Terlalu banyak
# permintaan". Isi angka > 0 bila ingin mengaktifkan kembali pembatasan.
RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT=0
LOGIN_RATE_LIMIT=0
PASSWORD_RESET_RATE_LIMIT=0

# ---- URL publik aplikasi (dipakai pada tautan di email) ----
PUBLIC_APP_URL=http://localhost:5173

# ---- Email (SMTP) ----
# Kosongkan SMTP_HOST untuk "mode log": isi email dicetak ke konsol server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=WISANGGENI CLIMBING CLUB <no-reply@wcc.id>
# Email pengurus untuk notifikasi pendaftaran baru (opsional).
REGISTRATION_NOTIFY_EMAIL=

# ---- Email (Hostinger Mail API) ----
# Alternatif tanpa SMTP: kirim lewat HTTP API api.mail.hostinger.com.
# Bila TOKEN diisi, mode ini dipakai dan mengalahkan pengaturan SMTP.
# Token dibuat di hPanel → Email → (domain) → Agentic Mail → API access.
HOSTINGER_MAIL_API_TOKEN=
# Opsional: paksa resource ID kotak surat (mis. AC1a2b...).
# Bila kosong, diambil otomatis dari GET /api/v1/me (cocok dengan MAIL_FROM).
HOSTINGER_MAIL_MAILBOX_ID=
# Opsional: override alamat API.
HOSTINGER_MAIL_API_URL=https://api.mail.hostinger.com

# ---- Penyimpanan berkas (unggahan) ----
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# ---- Google Sheets (sinkronisasi kas) ----
# ID spreadsheet: bagian antara /d/ dan /edit pada URL spreadsheet.
GOOGLE_SHEETS_ID=
# Nama tab/lembar tujuan (dibuat otomatis bila belum ada).
GOOGLE_SHEETS_TAB=Kas

# Pilih SALAH SATU mode integrasi:
#
# (A) Apps Script (paling mudah, tanpa Google Cloud Console).
#     Deploy Web App dari spreadsheet (Extensions → Apps Script → Deploy),
#     lalu isi URL yang berakhiran /exec di bawah. Lihat docs/apps-script/Code.gs.
GOOGLE_APPS_SCRIPT_URL=
# Rahasia bersama opsional; harus sama dengan nilai SECRET pada skrip Apps Script.
GOOGLE_APPS_SCRIPT_TOKEN=
#
# (B) Service account (butuh Google Cloud Console):
#   (b1) path ke berkas JSON service account (disarankan; jangan commit berkasnya):
GOOGLE_SERVICE_ACCOUNT_FILE=
#   (b2) JSON mentah satu baris, atau base64 — praktis untuk variabel lingkungan:
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# (C) OAuth 2.0 (memakai akun Google pemilik spreadsheet).
#     Isi Client ID + Client Secret dari Google Cloud Console, lalu refresh token
#     hasil otorisasi sekali (lihat README bagian 9 / OAuth).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Sinkronisasi otomatis berkala (menit). 0 = hanya manual.
SHEETS_SYNC_INTERVAL_MINUTES=0
# Batas waktu permintaan ke Google (ms).
SHEETS_REQUEST_TIMEOUT_MS=15000
