# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL lokal via docker compose) ----
DATABASE_URL=postgres://wcc:wcc@localhost:5432/wcc

# ---- Keamanan ----
# GANTI nilai ini dengan string acak panjang sebelum dipakai di produksi!
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang-minimal-32-karakter
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- CORS / cookie ----
CORS_ORIGIN=http://localhost:5173
# Set true bila sudah memakai HTTPS di produksi.
COOKIE_SECURE=false

# ---- Google Sheets (sinkronisasi kas) ----
# ID spreadsheet: bagian antara /d/ dan /edit pada URL spreadsheet.
GOOGLE_SHEETS_ID=
# Nama tab/lembar tujuan (dibuat otomatis bila belum ada).
GOOGLE_SHEETS_TAB=Kas
# Pilih SALAH SATU cara memasok kredensial service account:
#   (a) path ke berkas JSON service account (disarankan; jangan commit berkasnya):
GOOGLE_SERVICE_ACCOUNT_FILE=
#   (b) JSON mentah satu baris, atau base64 — praktis untuk variabel lingkungan:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Sinkronisasi otomatis berkala (menit). 0 = hanya manual.
SHEETS_SYNC_INTERVAL_MINUTES=0
# Batas waktu permintaan ke Google (ms).
SHEETS_REQUEST_TIMEOUT_MS=15000
