# Salin ke /etc/wcc/hermes.env, isi nilai asli, lalu:
#   sudo chown root:hermes /etc/wcc/hermes.env
#   sudo chmod 640 /etc/wcc/hermes.env
# Jangan pernah commit file hasil salinan ini.

# --- koneksi ke homeserver ----------------------------------------------
WCC_SSH_HOST=wcc@HOMESERVER
WCC_SSH_KEY=/home/hermes/.ssh/id_ed25519_wcc
WCC_REPO_DIR=/home/wcc/apps/WCC

# --- runner tugas -------------------------------------------------------
WCC_LOG_DIR=/home/hermes/.local/state/wcc/logs
WCC_TASK_TIMEOUT=3600

# --- OpenCode HTTP (hanya untuk Mode B / health check) ------------------
WCC_OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=<GANTI_PASSWORD_PANJANG_ACAK>

# --- produksi -----------------------------------------------------------
WCC_PROD_URL=https://wisanggeniclub.site
HOSTINGER_API_TOKEN=<GANTI_TOKEN_HOSTINGER>
HOSTINGER_ACCOUNT=<GANTI_ACCOUNT_ID>
HOSTINGER_DOMAIN=wisanggeniclub.site

# --- deploy -------------------------------------------------------------
WCC_BUILD_TIMEOUT=600
WCC_HEALTH_DELAY=20
# 1 = coba POST /builds bila build tidak terdeteksi (endpoint belum terverifikasi)
WCC_ALLOW_BUILD_TRIGGER=0
