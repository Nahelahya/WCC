# Salin file ini menjadi `.env` bila belum ada.

# Mode data:
#   live -> memakai backend REST asli (folder server/). Perlu menjalankan API.
#   mock -> memakai data demo di localStorage. Tanpa server.
VITE_API_MODE=live

# URL dasar API. Default '/api' (diteruskan proxy Vite ke http://localhost:4000).
# Bila backend berada di alamat lain, isi URL lengkap, mis. http://localhost:4000/api
VITE_API_URL=/api

# ---- Web Push (VAPID) — variabel server, disimpan di server/.env ----
# Generate dengan: node scripts/gen-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@wcc.id
